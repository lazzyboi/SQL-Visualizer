# Development or production
APP_ENV=development

# Flask secret. Use a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_SECONDS=28800

# Local development data paths. On Render use /var/data for persistent disk.
DATA_DIR=./data
USERS_DIR=./data/users
AUTH_DB_PATH=./data/app.db
HISTORY_FILE=./data/history.json

# MongoDB Atlas. In production this should be configured.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB=sqlviz
MONGO_USERS_COLLECTION=users
MONGO_HISTORY_COLLECTION=query_history
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Comma-separated emails that should receive the admin role on registration.
ADMIN_EMAILS=your-email@example.com

# AI
AI_PROVIDER=fallback
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT=20

MAX_HISTORY=200
MAX_OUTPUT_ROWS=500
ADMIN_QUERY_LIMIT=100
